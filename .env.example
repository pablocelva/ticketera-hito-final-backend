# Ejemplo de configuracion para el perfil prod.
# Copiar este archivo como .env (esta ignorado por git):
#   Copy-Item .env.example .env

# Base de datos
TICKETERA_DB_URL=jdbc:postgresql://localhost:5433/ticketera_db
TICKETERA_DB_USERNAME=user_ticketera
TICKETERA_DB_PASSWORD=your_secure_password_here

# Admin credentials (HTTP Basic)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password_here

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173